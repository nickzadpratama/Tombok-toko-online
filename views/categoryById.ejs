<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>National Geographic - Toko Klona</title>
    <style>
    /* Gaya Dasar */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #ffffff;
            color: #333;
        }

        /* Header / Navigasi */
        header {
            border-bottom: 1px solid #ddd;
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-box {
            background-color: #FFCC00;
            width: 25px;
            height: 35px;
        }

        .logo-text {
            font-weight: bold;
            font-size: 16px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 20px;
        }

        nav ul li a {
            text-decoration: none;
            color: #000;
            font-size: 13px;
            font-weight: bold;
            text-transform: uppercase;
        }

        nav ul li.active a {
            color: #000; /* Warna teks menjadi hitam pekat */
        }

        nav ul li.active::after {
            content: '';
            position: absolute;
            bottom: -16px; /* Posisi pas di atas garis batas header */
            left: 0;
            width: 100%;
            height: 3px; /* Ketebalan garis tanda aktif */
            background-color: #000; /* Warna garis hitam */
        }

        .right-menu {
            font-size: 13px;
            display: flex;
            gap: 15px;
            align-items: center;
        }

        /* Baris Info Produk */
        .product-count-bar {
            text-align: center;
            padding: 20px 0;
            font-size: 14px;
            font-weight: bold;
            border-bottom: 1px solid #eee;
            letter-spacing: 1px;
        }

        /* Tata Letak Utama */
        .container {
            padding: 40px;
        }

        /* Bagian Galeri Produk */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px 20px;
            width: 100%;
        }

        .product-card {
            background-color: #fff;
            text-align: center;
            position: relative;
        }

        /* Wadah Gambar - Dikunci Tingginya Agar Sama Rata */
        .image-container {
            background-color: #f5f5f5;
            position: relative;
            margin-bottom: 15px;
            height: 320px; /* Mengunci tinggi kotak agar semua produk sejajar */
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        /* Pengaturan Gambar Agar Mengikuti Wadah Tanpa Gepeng */
        .product-image {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain; /* Gambar akan mengecil/membesar proporsional */
            mix-blend-mode: multiply;
        }

        /* Label di atas Produk */
        .badge-container {
            position: absolute;
            top: 10px;
            left: 10px;
            display: flex;
            flex-direction: column;
            gap: 3px;
            align-items: flex-start;
            z-index: 10; /* Agar label berada di depan gambar */
        }

        .badge-local {
            background-color: #000;
            color: #fff;
            font-size: 9px;
            padding: 3px 6px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .badge-promo {
            background-color: #eee;
            color: #333;
            font-size: 9px;
            padding: 2px 5px;
            border: 1px solid #ccc;
        }

        /* Info Teks Produk */
        .product-name {
            font-size: 11px;
            text-transform: uppercase;
            color: #333;
            margin-bottom: 8px;
            line-height: 1.4;
            padding: 0 10px;
            font-weight: normal;
            min-height: 32px; /* Mengunci tinggi teks nama agar harga tetap sejajar */
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .product-price {
            font-size: 12px;
            font-weight: bold;
            color: #000;
        }
    </style>
</head>
<body>

    <!-- Bagian Atas / Header -->
    <header>
        <div class="logo-area">
            <div class="logo-box"></div>
            <div class="logo-text">Tombol<br>Store</div>
        </div>
        <nav>
            <ul>
                <li><a href="/<%= userId %>/products">All</a></li>
                <% categories.forEach(el => { %>
                    <li><a href="/<%= userId %>/categories/<%= el.id %>"><%= el.name %></a></li>
                <% }) %>
            </ul>
        </nav>
        <div class="right-menu">
            <span><a href="/products/add">Add Product</a></span>
            <span><a href="/logout">Logout</a></span>
        </div>
    </header>

    <!-- Baris Jumlah Produk -->
    <div class="product-count-bar">
        <%= notifikasi %>
    </div>

    <!-- Konten Utama -->
    <div class="container">
        
        <!-- Daftar Baju Langsung Memenuhi Halaman -->
        <main class="product-grid">
            
            <!-- Kartu Produk 1 -->
             <% category.Products.forEach(el => { %>
              
                <div class="product-card">
                    <div class="image-container">
                    <div class="badge-container">
                        <span class="badge-local">Local Collection</span>
                        <span class="badge-promo">B1G1</span>
                    </div>
                    <img src="<%= el.imageURL %>" alt="Baju" class="product-image">
                </div>
                <div class="product-name"><%= el.name %></div>
                <div class="product-price"><%= getFormatPrice(el.price) %> %></div>
                <a href="/<%= userId %>/products/<%= el.id %>">See Detail</a>
            </div>
            <% }) %>
        </main>
    </div>

</body>
</html>